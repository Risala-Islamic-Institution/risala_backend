#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

export DJANGO_SETTINGS_MODULE="${DJANGO_SETTINGS_MODULE:-config.settings.production}"


python /app/manage.py migrate --noinput

python /app/manage.py setup_admin || true

python /app/manage.py collectstatic --noinput

# Render shared nodes automatically inject WEB_CONCURRENCY=4, which exceeds the 512MB
# limit of starter/free instances and triggers an Out-Of-Memory kill.
# Default to 1 worker so memory remains safely below 150MB. When more RAM is provisioned,
# operators can set GUNICORN_WORKERS in Render to scale up workers seamlessly.
WORKERS="${GUNICORN_WORKERS:-1}"

exec gunicorn config.asgi \
    --bind "0.0.0.0:${PORT:-5000}" \
    --chdir=/app \
    -k uvicorn_worker.UvicornWorker \
    --workers "${WORKERS}" \
    --max-requests 1000 \
    --max-requests-jitter 50 \
    --timeout 120
